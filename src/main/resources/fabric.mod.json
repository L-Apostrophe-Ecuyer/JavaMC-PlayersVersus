{
  "schemaVersion": 1,
  "id": "players-versus",
  "version": "${version}",

  "name": "Players Versus",
  "description": "Improves the challenge of Minecraft; less frustration, more fear, more fun.",
  "authors": [
    "Frootloop"
  ],
  "contact": {
    "homepage": "https://fabricmc.net/",
    "sources": "https://github.com/FabricMC/fabric-example-mod"
  },

  "license": "CC0-1.0",
  "icon": "assets/players-versus/icon.png",

  "environment": "*",
	"entrypoints": {
		"main": [
			"frootloops.versus.VersusMod"
		],
		"client": [
			"frootloops.versus.VersusModClient"
		]
	},
	"mixins": [
		"players-versus.mixins.json",
		{
			"config": "players-versus.client.mixins.json",
			"environment": "client"
		}
	],
  "depends": {
    "fabricloader": ">=0.17.2",
    "fabric-api": ">=0.128",
    "minecraft": ">=1.21.7",
    "java": ">=21"
  },
  "suggests": {
    "c2me": ">=0.3.4"
  }
}
